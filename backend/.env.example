# SafeHer Backend Configuration

# Server
PORT=5000

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=safeher_db
DB_PORT=3306

# Authentication
JWT_SECRET=your_super_secret_key_here

# Email Service Configuration
# Two options available: 'smtp' or 'resend'
EMAIL_SERVICE=smtp

# SMTP Configuration (for Nodemailer)
# Leave empty to disable email sending
# For Gmail, use App Passwords: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=SafeHer <orders@safeher.co.za>

# Resend Configuration (Alternative to SMTP)
# Uncomment to use Resend API instead of SMTP
# EMAIL_SERVICE=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=SafeHer <orders@safeher.co.za>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PayFast (notification URL is the complete externally reachable callback URL)
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_NOTIFY_URL=
# Card entry demo only; never charges money. Defaults off in production.
CARD_DEMO_ENABLED=false
